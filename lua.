local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

-- ฟังก์ชันหา Parent ที่ปลอดภัยสำหรับ Executor (รองรับ gethui หรือ CoreGui)
local function getParent()
	if gethui then
		return gethui()
	elseif CoreGui:FindFirstChild("RobloxGui") then
		return CoreGui
	else
		return player:WaitForChild("PlayerGui")
	end
end

-- ป้องกันสร้างซ้ำ
local parentGui = getParent()
if parentGui:FindFirstChild("BXDHubClosedNotice") then
	parentGui.BXDHubClosedNotice:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BXDHubClosedNotice"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- ป้องกันไม่ให้รีเซ็ตตอนตัวละครตาย และซ่อนจาก CoreGui ถ้าทำได้
if syn and syn.protect_gui then
	syn.protect_gui(screenGui)
elseif protectgui then
	protectgui(screenGui)
end

screenGui.Parent = parentGui

